    border-color: var(--purple-300);
    transform: translateY(-1px);
  }

  .hv-tab[aria-selected='true'] {
    border-color: var(--theme-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--theme-brand) 16%, transparent);
  }

  .hv-tab__num {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--ink-600);
    background: var(--theme-surface-1);
    transition: background 0.25s ease, color 0.25s ease;
  }

  .hv-tab[aria-selected='true'] .hv-tab__num {
    color: #fff;
    background: var(--theme-primary);
  }

  .hv-tab__title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .hv-tab__sub {
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-500);
  }

  .hv-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 22px;
  }

  .hv-panel[hidden] {
    display: none;
  }

  .hv-paths.is-enhanced .hv-panel:not([hidden]) {
    animation: hv-panel-in 0.4s ease both;
  }

  @keyframes hv-panel-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .hv-panel__kicker {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--purple-700);
  }

  .hv-paths.is-enhanced .hv-panel__kicker {
    display: none;
  }

  .hv-panel h3 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .hv-checks {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .hv-checks li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 0.7rem;
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--ink-800);
  }

  .hv-checks svg {
    width: 22px;
    height: 22px;
    color: var(--accent-emerald);
  }

  .hv-panel__time {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
    padding: 0.55rem 0.95rem;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-700);
    background: var(--theme-surface-1);
    border-radius: 99px;
  }

  .hv-panel__time svg {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--accent-blue);
  }

  .hv-panel__main .hv-btn {
    display: flex;
    width: fit-content;
  }

  .hv-panel__cases {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hv-mini {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.95rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    background: var(--ink-50);
    border: 1px solid var(--theme-surface-2);
    border-radius: 14px;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .hv-mini:hover {
    background: #fff;
    border-color: var(--purple-300);
    transform: translateX(3px);
  }

  .hv-mini img {
    width: 104px;
    height: 78px;
    object-fit: cover;
    object-position: top;
    border-radius: 9px;
    border: 1px solid var(--theme-surface-2);
  }

  .hv-mini__body strong {
    display: block;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .hv-mini__body span {
    display: block;
    font-size: 0.83rem;
    line-height: 1.4;
    color: var(--ink-500);
  }

  .hv-mini__arrow {
    color: var(--theme-primary);
  }

  /* ═══════════════════════════════════════════
     4. ΠΡΙΝ → ΜΕΤΑ
     ═══════════════════════════════════════════ */

  .hv-cases__nav {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.4rem;
    overflow-x: auto;
    background: var(--theme-surface-1);
    border-radius: 16px;
    scrollbar-width: none;
  }

  .hv-cases__nav::-webkit-scrollbar {
    display: none;
  }

  .hv-stories:not(.is-enhanced) .hv-cases__nav {
    display: none;
  }

  .hv-stories:not(.is-enhanced) .hv-case + .hv-case {
    margin-top: 1rem;
  }

  /* Μοιράζονται το πλάτος. Στο κινητό κρατάνε ελάχιστο πλάτος και η σειρά
     σκρολάρει οριζόντια. */
  .hv-case-tab {
    flex: 1 1 0;
    min-width: 11.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.7rem 1rem;
    font: inherit;
    text-align: left;
    color: var(--ink-600);
    background: transparent;
    border: 0;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .hv-case-tab:hover {
    color: var(--ink-900);
    background: rgba(255, 255, 255, 0.6);
  }

  .hv-case-tab[aria-selected='true'] {
    color: var(--ink-900);
    background: #fff;
    box-shadow: 0 1px 2px rgba(26, 29, 35, 0.06), 0 6px 16px -10px rgba(26, 29, 35, 0.25);
  }

  .hv-case-tab:focus-visible {
    outline: 2px solid var(--theme-brand);
    outline-offset: 2px;
  }

  .hv-case-tab__name {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hv-case-tab__gain {
    font-size: 0.78rem;
    color: var(--ink-500);
  }

  .hv-case {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 22px;
  }

  .hv-case[hidden] {
    display: none;
  }

  .hv-stories.is-enhanced .hv-case:not([hidden]) {
    animation: hv-panel-in 0.4s ease both;
  }

  .hv-frame {
    display: block;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 16px;
    box-shadow: 0 34px 70px -44px rgba(26, 29, 35, 0.45), 0 12px 24px -20px rgba(26, 29, 35, 0.2);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .hv-frame:hover {
    transform: translateY(-3px);
    box-shadow: 0 40px 80px -44px rgba(26, 29, 35, 0.5), 0 14px 28px -20px rgba(26, 29, 35, 0.22);
  }

  .hv-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 40px;
    padding: 0 0.9rem;
    background: var(--ink-50);
    border-bottom: 1px solid var(--theme-surface-2);
  }

  .hv-frame__dots {
    display: flex;
    gap: 6px;
  }

  .hv-frame__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-200);
  }

  .hv-frame__url {
    flex: 1;
    max-width: 260px;
    margin-inline: auto;
    padding: 0.2rem 0.9rem;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-500);
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 99px;
  }

  .hv-frame__screen {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--ink-100);
  }

  .hv-frame__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .hv-case__meta {
    margin-bottom: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .hv-case h3 {
    margin-bottom: 1.1rem;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    letter-spacing: -0.03em;
  }

  /* Πριν / μετά ως δύο σειρές με ετικέτα αριστερά, ενωμένες σαν ένα μπλοκ. */
  .hv-case__ba {
    margin-bottom: 1.1rem;
    overflow: hidden;
    border: 1px solid var(--theme-surface-2);
    border-radius: 14px;
  }

  .hv-case__row {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .hv-case__row--before {
    color: var(--ink-600);
    background: color-mix(in srgb, var(--accent-rose) 5%, #fff);
  }

  .hv-case__row--after {
    color: var(--ink-800);
    background: color-mix(in srgb, var(--accent-emerald) 7%, #fff);
    border-top: 1px solid var(--theme-surface-2);
  }

  .hv-case__label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hv-case__row--before .hv-case__label {
    color: var(--accent-rose);
  }

  .hv-case__row--after .hv-case__label {
    color: #1f5f53;
  }

  .hv-case__gain {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-900);
  }

  .hv-case__gain svg {
    flex: none;
    color: var(--accent-emerald);
  }

  /* Το global blockquote (typography.css) βάζει σκούρα γραμμή και βάρος 500. */
  .hv-case__quote {
    margin: 0 0 1.1rem;
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--ink-700);
    background: var(--ink-50);
    border-left: 3px solid var(--theme-brand);
    border-radius: 0 12px 12px 0;
  }

  .hv-case__quote footer {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-800);
  }

  .hv-case__quote.ph {
    border-left-color: transparent;
    border-radius: 12px;
  }

  .hv-stories__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ═══════════════════════════════════════════
     5. ΚΡΙΤΙΚΕΣ
     ═══════════════════════════════════════════ */

  .hv-reviews {
    background: var(--theme-surface-1);
  }

  .hv-reviews__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .hv-reviews__top .hv-title {
    max-width: 16ch;
  }

  /* Η «ταμπέλα» του Google: βαθμός, αστέρια, πλήθος και link σε μία σειρά. */
  .hv-google {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    padding: 1rem 1.35rem;
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 16px;
  }

  .hv-google__rating {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .hv-google__rating .ph {
    font-size: 1rem;
    letter-spacing: 0;
  }

  .hv-google__count {
    font-size: 0.9rem;
    color: var(--theme-on-bg-muted);
  }

  .hv-stars {
    display: flex;
    gap: 2px;
    color: #c9962f;
  }

  .hv-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .hv-review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: 1.4rem;
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 18px;
  }

  .hv-review blockquote {
    flex: 1;
    padding: 0;
    border: 0;
    font-weight: 400;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-700);
  }

  .hv-review figcaption {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8rem;
    color: var(--ink-500);
  }

  .hv-review figcaption strong {
    display: block;
    font-size: 0.86rem;
    color: var(--ink-800);
  }

  .hv-review figcaption > span:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .hv-review__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: var(--ink-800);
    border-radius: 50%;
  }

  /* ═══════════════════════════════════════════
     6. ΟΜΑΔΑ + ΔΕΣΜΕΥΣΕΙΣ
     ═══════════════════════════════════════════ */

  .hv-promise__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .hv-team {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
  }

  .hv-team img,
  .hv-team__ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 20px;
  }

  .hv-team__ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-600);
    background: repeating-linear-gradient(135deg, var(--ink-100) 0 12px, var(--ink-50) 12px 24px);
    outline-offset: -1px;
  }

  .hv-team__ph strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink-800);
  }

  .hv-team__ph code {
    font-size: 0.82rem;
    padding: 0.1rem 0.35rem;
    background: #fff;
    border-radius: 5px;
  }

  .hv-team figcaption strong {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .hv-team figcaption > span {
    display: block;
    max-width: 46ch;
    margin-bottom: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--theme-on-bg-muted);
  }

  .hv-terms {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--theme-surface-2);
    border-radius: 22px;
    box-shadow: 0 34px 64px -48px rgba(26, 29, 35, 0.45);
  }

  .hv-terms::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--gradient-accent);
  }

  .hv-terms__head {
    padding-bottom: 1rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-500);
    border-bottom: 1px solid var(--theme-surface-2);
  }

  .hv-terms__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hv-terms__list li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.2rem 0;
    border-bottom: 1px dashed var(--theme-surface-2);
  }

  .hv-terms__num {
    padding-top: 0.2rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--theme-primary);
    font-variant-numeric: tabular-nums;
  }

  .hv-terms h3 {
    margin-bottom: 0.3rem;
    font-size: 1.12rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .hv-terms p {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--theme-on-bg-muted);
  }

  .hv-terms__sign {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-500);
  }

  .hv-terms__sign :global(.hv-terms__logo) {
    height: 40px;
    width: auto;
  }

  /* ═══════════════════════════════════════════
     7. ΠΩΣ ΞΕΚΙΝΑΜΕ
     ═══════════════════════════════════════════ */

  .hv-plan {
    background: var(--gradient-subtle);
  }

  .hv-plan__steps {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
  }

  /* Η διακεκομμένη γραμμή που ενώνει τα βήματα, από κέντρο σε κέντρο. */
  .hv-plan__steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--purple-300) 0 8px, transparent 8px 16px);
  }

  .hv-step {
    text-align: center;
  }

  .hv-step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--theme-primary);
    background: #fff;
    border: 2px solid var(--purple-200);
    border-radius: 50%;
  }

  .hv-step:last-child .hv-step__num {
    color: #fff;
    background: var(--theme-primary);
    border-color: var(--theme-primary);
  }

  .hv-step h3 {
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .hv-step p {
    max-width: 34ch;
    margin-inline: auto;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--theme-on-bg-muted);
  }

  .hv-plan__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    margin-top: clamp(2.75rem, 5vw, 3.75rem);
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════ */

  @media (max-width: 1024px) {
    .hv-gains__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hv-stakes__bottom,
    .hv-promise__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-stakes__cta {
      max-width: 560px;
    }

    .hv-team {
      max-width: 620px;
    }
  }

  @media (max-width: 879px) {
    .hv-panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-paths__tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-reviews__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-case {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-case .hv-frame {
      max-width: 560px;
    }
  }

  @media (max-width: 768px) {
    .hv-gains__grid,
    .hv-stats,
    .hv-plan__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-stats {
      gap: 1.75rem;
    }

    .hv-plan__steps::before {
      display: none;
    }

    .hv-calc__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .hv-case__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }
  }

  @media (max-width: 480px) {
    .hv-calc__result {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }

    .hv-calc__result > div {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .hv-mini {
      grid-template-columns: 84px minmax(0, 1fr);
