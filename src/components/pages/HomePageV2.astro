// Calculator: οι αρχικές τιμές υπολογίζονται και στο build, ώστε χωρίς JS
// να φαίνεται ένα σωστό παράδειγμα και όχι κενά πεδία.
const calc = { visits: 3000, value: 60, uplift: 0.5 };
const nf0 = new Intl.NumberFormat('el-GR', { maximumFractionDigits: 0 });
const nf2 = new Intl.NumberFormat('el-GR', { maximumFractionDigits: 2 });
const calcExtra = (calc.visits * calc.uplift) / 100;
const calcMonth = calcExtra * calc.value;
const calcInitial = {
  uplift: `+${nf2.format(calc.uplift)}`,
  every: nf0.format(100 / calc.uplift),
  extra: `+${nf0.format(calcExtra)}`,
  month: `${nf0.format(calcMonth)} €`,
  year: `${nf0.format(calcMonth * 12)} €`,
  fill: `${((calc.uplift - 0.25) / 1.75) * 100}%`,
};

