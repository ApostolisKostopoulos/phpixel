  {
    q: 'Εγγυάστε θέσεις στη Google ή πωλήσεις;',
    a: 'Όχι, και να προσέχεις όποιον το κάνει: κανείς δεν ελέγχει τη Google ή την αγορά. Αυτό που αναλαμβάνουμε είναι όσα ελέγχονται: γρήγορο site, σωστή τεχνική βάση, καθαρή διαδρομή αγοράς και μετρήσεις που βλέπεις κι εσύ. Πάνω σε αυτά χτίζονται τα αποτελέσματα.',
  },
  {
    q: 'Με ποια τεχνολογία δουλεύετε;',
    a: 'Με WordPress, WooCommerce, CS-Cart, Astro, React και Node.js. Αλλά το εργαλείο δεν κάνει τη δουλειά, ο τρόπος που το χρησιμοποιείς ναι. Γι’ αυτό διαλέγουμε ό,τι ταιριάζει στο δικό σου έργο, όχι ό,τι μας βολεύει.',
  },
  {
    q: 'Δουλεύετε πανελλαδικά;',
    a: 'Ναι. Δουλεύουμε με επιχειρήσεις σε όλη την Ελλάδα και τα περισσότερα projects τρέχουν εξ ολοκλήρου online: κλήσεις, preview links, καθημερινή επικοινωνία.',
  },
];

const ARROW =
  '<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
const CHECK =
  '<circle cx="12" cy="12" r="9.2"/><path d="M8.2 12.4l2.6 2.6 5-5.2"/>';
const STAR =
  'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z';
---

<HomeHero />

<!-- ═══════════════════════════════════════════════
     1. ΤΙ ΚΕΡΔΙΖΕΙΣ
     ═══════════════════════════════════════════════ -->
<section class="hv hv-gains" aria-labelledby="hv-gains-title">
  <div class="container">
    <header class="hv-head reveal">
      <span class="hv-eyebrow">Τι κερδίζεις</span>
      <h2 id="hv-gains-title" class="hv-title">Αυτό που μένει στο τέλος δεν είναι ο κώδικας.</h2>
      <p class="hv-lead">
        Είναι όσα αλλάζουν στη δουλειά σου από τη μέρα που θα βγει live. Ξεκινάμε από εκεί και
        δουλεύουμε ανάποδα: πρώτα τι θες να κερδίσεις, μετά με ποια εργαλεία.
      </p>
    </header>

    <div class="hv-gains__grid">
      {gains.map((g, i) => (
        <div class="reveal" style={`transition-delay: ${(i % 3) * 0.08}s`}>
          <article class="hv-gain">
            <p class="hv-gain__pain">
              <span class="hv-gain__dot" aria-hidden="true"></span>
              <span class="sr-only">Αντί για: </span>
              <s>{g.pain}</s>
            </p>
            <span class="hv-gain__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={g.icon} />
            </span>
            <h3>{g.title}</h3>
            <p class="hv-gain__text">{g.text}</p>
            <a class="hv-gain__how" href={g.href}>
              <span class="hv-gain__how-label">Πώς:</span>
              {g.how}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
            </a>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     2. ΤΙ ΣΟΥ ΚΟΣΤΙΖΕΙ ΣΗΜΕΡΑ (+ calculator)
     ═══════════════════════════════════════════════ -->
<section class="hv hv-stakes on-dark" aria-labelledby="hv-stakes-title">
  <div class="hv-stakes__bg" aria-hidden="true"></div>
  <div class="container">
    <header class="hv-head reveal">
      <span class="hv-eyebrow">Τι σου κοστίζει σήμερα</span>
      <h2 id="hv-stakes-title" class="hv-title">
        Ένα site που δεν δουλεύει δεν είναι ουδέτερο. Σου κοστίζει κάθε μέρα.
      </h2>
      <p class="hv-lead">
        Δεν το βλέπεις σε κανέναν λογαριασμό. Το βλέπεις στα καλάθια που δεν ολοκληρώνονται, στα
        ραντεβού που δεν κλείνονται και στους πελάτες που πάνε αλλού χωρίς να σου πουν γιατί.
      </p>
    </header>

    <ul class="hv-stats">
      {stakes.map((s, i) => (
        <li class="hv-stat reveal" style={`transition-delay: ${i * 0.1}s`}>
          <p class="hv-stat__value">{s.value}</p>
          <p class="hv-stat__label">{s.label}</p>
          <p class="hv-stat__source">
            Πηγή: <a href={s.href} target="_blank" rel="noopener">{s.source}</a>
          </p>
        </li>
      ))}
    </ul>

    <div class="hv-stakes__bottom">
      <div class="hv-calc reveal" role="group" aria-labelledby="hv-calc-title" data-calc>
        <h3 id="hv-calc-title">Πόσο αξίζει για σένα λίγο καλύτερο site;</h3>
        <p class="hv-calc__intro">Βάλε τα δικά σου νούμερα.</p>

        <div class="hv-calc__fields">
          <label class="hv-field">
            <span>Επισκέψεις τον μήνα</span>
            <input type="number" inputmode="numeric" min="0" step="100" value={calc.visits} data-calc-visits />
          </label>
          <label class="hv-field">
            <span>Μέση αξία παραγγελίας ή πελάτη</span>
            <span class="hv-field__affix">
              <input type="number" inputmode="numeric" min="0" step="5" value={calc.value} data-calc-value />
              <span aria-hidden="true">€</span>
            </span>
          </label>
          <label class="hv-field hv-field--range">
            <span>
              Επιπλέον πελάτες ανά 100 επισκέψεις: <strong data-calc-uplift-out>{calcInitial.uplift}</strong>
              <em>(1 ακόμα κάθε <span data-calc-every>{calcInitial.every}</span> επισκέψεις)</em>
            </span>
            <input
              type="range"
              min="0.25"
              max="2"
              step="0.25"
              value={calc.uplift}
              style={`--p: ${calcInitial.fill}`}
              data-calc-uplift
            />
          </label>
        </div>

        <div class="hv-calc__result" aria-live="polite">
          <div><output data-calc-extra>{calcInitial.extra}</output><span>πελάτες τον μήνα</span></div>
          <div><output data-calc-month>{calcInitial.month}</output><span>τον μήνα</span></div>
          <div><output data-calc-year>{calcInitial.year}</output><span>τον χρόνο</span></div>
        </div>

        <p class="hv-calc__note">
          Απλή αριθμητική με τα δικά σου νούμερα, όχι υπόσχεση. Δείχνει πόσο μεγάλο είναι το παιχνίδι.
        </p>
      </div>

      <div class="hv-stakes__cta reveal">
        <p class="hv-stakes__good">
          Τα καλά νέα: τα περισσότερα από αυτά είναι θέμα σχεδιασμού, όχι τύχης. Άρα διορθώνονται.
        </p>
        <a href="/contact" class="hv-btn hv-btn--light">
          Στείλε μας το link σου
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
        </a>
        <p class="hv-stakes__small">Θα σου πούμε τι σου κοστίζει πελάτες, χωρίς δέσμευση.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     3. ΑΠΟ ΠΟΥ ΞΕΚΙΝΑΣ (tabs, χωρίς JS: όλα ανοιχτά)
     ═══════════════════════════════════════════════ -->
<section class="hv hv-paths" aria-labelledby="hv-paths-title" data-tabs>
  <div class="container">
    <header class="hv-head hv-head--center reveal">
      <span class="hv-eyebrow">Από πού ξεκινάς</span>
      <h2 id="hv-paths-title" class="hv-title">Πού βρίσκεσαι σήμερα;</h2>
      <p class="hv-lead">
        Διάλεξε. Θα δεις τι έχεις στο τέλος, πόσο παίρνει και ποιοι ξεκίνησαν από το ίδιο σημείο.
      </p>
    </header>

    <div class="hv-paths__tabs reveal" role="tablist" aria-label="Από πού ξεκινάς">
      {paths.map((p, i) => (
        <button
          type="button"
          role="tab"
          class="hv-tab"
          id={`hv-tab-${p.id}`}
          aria-controls={`hv-panel-${p.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab
        >
          <span class="hv-tab__num" aria-hidden="true">{`0${i + 1}`}</span>
          <span class="hv-tab__title">{p.tab}</span>
          <span class="hv-tab__sub">{p.sub}</span>
        </button>
      ))}
    </div>

    {paths.map((p) => (
      <div class="hv-panel" role="tabpanel" id={`hv-panel-${p.id}`} aria-labelledby={`hv-tab-${p.id}`} data-panel>
        <div class="hv-panel__main">
          <p class="hv-panel__kicker">{p.tab}</p>
          <h3>{p.title}</h3>
          <p class="hv-overline">Τι έχεις στο τέλος</p>
          <ul class="hv-checks">
            {p.gets.map((g) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CHECK} />
                <span>{g}</span>
              </li>
            ))}
          </ul>
          <p class="hv-panel__time">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.1 2.1"/></svg>
            {p.time}
          </p>
          <a href="/contact" class="hv-btn hv-btn--primary">
            {p.cta}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
          </a>
        </div>

        <aside class="hv-panel__cases" aria-label="Επιχειρήσεις που ξεκίνησαν από εδώ">
          <p class="hv-overline">Ξεκίνησαν από εδώ</p>
          {p.cases.map((slug) => {
            const c = caseBySlug[slug];
            return c ? (
              <a class="hv-mini" href={`/portfolio/${c.slug}`}>
                <img src={c.img} alt="" width="1200" height="900" loading="lazy" decoding="async" />
                <span class="hv-mini__body">
                  <strong>{c.name}</strong>
                  <span>{c.gain}</span>
                </span>
                <svg class="hv-mini__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
              </a>
            ) : null;
          })}
        </aside>
      </div>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     4. ΠΡΙΝ → ΜΕΤΑ (ένας πελάτης τη φορά, χωρίς JS: όλοι ανοιχτοί)
     ═══════════════════════════════════════════════ -->
<section class="hv hv-stories" aria-labelledby="hv-stories-title" data-tabs>
  <div class="container">
    <header class="hv-head reveal">
      <span class="hv-eyebrow">Πριν και μετά</span>
      <h2 id="hv-stories-title" class="hv-title">Τι άλλαξε για επιχειρήσεις σαν τη δική σου.</h2>
      <p class="hv-lead">
        Χωρίς φουσκωμένα νούμερα: τι υπήρχε πριν, τι υπάρχει τώρα και τι κέρδισε η κάθε επιχείρηση.
      </p>
    </header>

    <div class="hv-cases__nav reveal" role="tablist" aria-label="Επιχειρήσεις">
      {cases.map((c, i) => (
        <button
          type="button"
          role="tab"
          class="hv-case-tab"
          id={`hv-case-tab-${c.slug}`}
          aria-controls={`hv-case-${c.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab
        >
          <span class="hv-case-tab__name">{c.name}</span>
          <span class="hv-case-tab__gain">{c.gain}</span>
        </button>
      ))}
    </div>

    {cases.map((c) => (
      <article
        class="hv-case"
        role="tabpanel"
        id={`hv-case-${c.slug}`}
        aria-labelledby={`hv-case-tab-${c.slug}`}
        data-panel
      >
        <a class="hv-frame" href={`/portfolio/${c.slug}`} tabindex="-1" aria-hidden="true">
          <span class="hv-frame__bar">
            <span class="hv-frame__dots"><i></i><i></i><i></i></span>
            <span class="hv-frame__url">{c.domain}</span>
          </span>
          <span class="hv-frame__screen">
            <img src={c.img} alt="" width="1200" height="900" loading="lazy" decoding="async" />
          </span>
        </a>

        <div class="hv-case__body">
          <p class="hv-case__meta">{c.industry}</p>
          <h3>{c.name}</h3>

          <div class="hv-case__ba">
            <div class="hv-case__row hv-case__row--before">
              <span class="hv-case__label">Πριν</span>
              <p>{c.before}</p>
            </div>
            <div class="hv-case__row hv-case__row--after">
              <span class="hv-case__label">Μετά</span>
              <p>{c.after}</p>
            </div>
          </div>

          <p class="hv-case__gain">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CHECK} />
            {c.gain}
          </p>

          {c.quote ? (
            <blockquote class="hv-case__quote">
              <p>“{c.quote.text}”</p>
              <footer>{c.quote.author}{c.quote.role ? `, ${c.quote.role}` : ''}</footer>
            </blockquote>
          ) : (
            <blockquote class="hv-case__quote ph">
              <p>{c.ask}</p>
            </blockquote>
          )}

          <a class="hv-link" href={`/portfolio/${c.slug}`}>
            Δες όλη την ιστορία
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
          </a>
        </div>
      </article>
    ))}

    <div class="hv-stories__more reveal">
      <a href="/portfolio" class="hv-btn hv-btn--outline">
        Όλα τα projects
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     5. ΚΡΙΤΙΚΕΣ GOOGLE (placeholders μέχρι να μπουν οι πραγματικές)
     ═══════════════════════════════════════════════ -->
<section class="hv hv-reviews" aria-labelledby="hv-reviews-title">
  <div class="container">
    <div class="hv-reviews__top reveal">
      <div>
        <span class="hv-eyebrow">Κριτικές</span>
        <h2 id="hv-reviews-title" class="hv-title hv-title--sm">Τι λένε όσοι δούλεψαν μαζί μας.</h2>
      </div>

      <div class="hv-google">
        <p class="hv-google__rating">
          <span class:list={[{ ph: !googleReviews.rating }]}>{googleReviews.rating || '[Βαθμολογία, π.χ. 4,9]'}</span>
        </p>
        <span class="hv-stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={STAR} /></svg>
          ))}
        </span>
        <p class="hv-google__count">
          <span class:list={[{ ph: !googleReviews.count }]}>
            {googleReviews.count ? `${googleReviews.count} κριτικές` : '[Πλήθος] κριτικές'}
          </span>
          στο Google
        </p>
        {googleReviews.profileUrl ? (
          <a class="hv-link" href={googleReviews.profileUrl} target="_blank" rel="noopener">
            Δες τις όλες στο Google
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
          </a>
        ) : (
          <span class="hv-link ph">[Link του Google Business Profile]</span>
        )}
      </div>
    </div>

    <div class="hv-reviews__grid">
      {googleReviews.items.map((r, i) => (
        <figure class="hv-review reveal" style={`transition-delay: ${i * 0.08}s`}>
          <span class="hv-stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={STAR} /></svg>
            ))}
          </span>
          <blockquote class:list={[{ ph: !r.text }]}>{r.text || LOREM}</blockquote>
          <figcaption>
            <span class="hv-review__avatar" aria-hidden="true">{r.author ? r.author.charAt(0) : '?'}</span>
            <span>
              <strong class:list={[{ ph: !r.author }]}>{r.author || '[Όνομα όπως εμφανίζεται στο Google]'}</strong>
              <span class:list={[{ ph: !r.when }]}>{r.when || '[πότε, π.χ. πριν από 2 μήνες]'}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     6. ΟΜΑΔΑ + ΟΙ ΔΕΣΜΕΥΣΕΙΣ ΜΑΣ
     ═══════════════════════════════════════════════ -->
<section class="hv hv-promise" aria-labelledby="hv-promise-title">
  <div class="container">
    <header class="hv-head reveal">
      <span class="hv-eyebrow">Οι όροι μας</span>
      <h2 id="hv-promise-title" class="hv-title">
        Γραμμένα από πριν, για να μη χρειαστεί να τα συζητήσουμε μετά.
      </h2>
    </header>

    <div class="hv-promise__layout">
      <figure class="hv-team reveal">
        {teamPhotoExists ? (
          <img src={TEAM_PHOTO} alt="Η ομάδα της phpixel" width="1600" height="1200" loading="lazy" decoding="async" />
        ) : (
          <div class="hv-team__ph ph">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8.5h3l1.6-2.3h6.8L17 8.5h3v10.3H4z"/><circle cx="12" cy="13.3" r="3.4"/></svg>
            <p>
              <strong>[Φωτογραφία της ομάδας]</strong>
              Μία πραγματική φωτογραφία, όχι stock: οριζόντια 4:3, περίπου 1600×1200, κατά προτίμηση
              στον χώρο που δουλεύετε. Αποθήκευσέ τη ως <code>public/images/team.webp</code> και θα
              εμφανιστεί εδώ αυτόματα.
            </p>
          </div>
        )}
        <figcaption>
          <strong>Με ποιους θα μιλάς</strong>
          <span>
            Μια μικρή ομάδα με 10+ χρόνια στο e-commerce. Οι ίδιοι άνθρωποι από την πρώτη κουβέντα
            μέχρι μετά το launch.
          </span>
          <a href="/about" class="hv-link">
            Γνώρισέ μας
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
          </a>
        </figcaption>
      </figure>

      <div class="hv-terms reveal" style="transition-delay: 0.1s">
        <p class="hv-terms__head">Ισχύει για κάθε συνεργασία</p>
        <ol class="hv-terms__list">
          {promises.map((p, i) => (
            <li>
              <span class="hv-terms__num" aria-hidden="true">{`0${i + 1}`}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="hv-terms__sign">
          <span>Με την υπογραφή μας,</span>
          <Logo class="hv-terms__logo" decorative loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     7. ΠΩΣ ΞΕΚΙΝΑΜΕ
     ═══════════════════════════════════════════════ -->
<section class="hv hv-plan" aria-labelledby="hv-plan-title">
  <div class="container">
    <header class="hv-head hv-head--center reveal">
      <span class="hv-eyebrow">Πώς ξεκινάμε</span>
      <h2 id="hv-plan-title" class="hv-title">Τρία βήματα μέχρι να δουλεύει για σένα.</h2>
    </header>

    <ol class="hv-plan__steps">
      {steps.map((s, i) => (
        <li class="hv-step reveal" style={`transition-delay: ${i * 0.1}s`}>
          <span class="hv-step__num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="hv-plan__cta reveal">
      <a href="/contact" class="hv-btn hv-btn--primary hv-btn--lg">
        Πες μας για το project σου
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
      </a>
      <a href="/how-we-work" class="hv-link">
        Δες αναλυτικά πώς δουλεύουμε
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" set:html={ARROW} />
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     8. FAQ (με FAQPage schema)
     ═══════════════════════════════════════════════ -->
<FaqSection items={faqItems} label="Συχνές ερωτήσεις" title="Ό,τι θα ρωτούσες πριν ξεκινήσουμε." />

<!-- Calculator και tabs. Vanilla JS, μηδέν dependencies.
     Χωρίς JS: το calculator δείχνει το παράδειγμα του build και όλα τα
     panels των tabs είναι ανοιχτά, το ένα κάτω από το άλλο. -->
<script is:inline>
  (() => {
    const nf0 = new Intl.NumberFormat('el-GR', { maximumFractionDigits: 0 });
    const nf1 = new Intl.NumberFormat('el-GR', { maximumFractionDigits: 1 });
    const nf2 = new Intl.NumberFormat('el-GR', { maximumFractionDigits: 2 });

    function initCalc(root) {
      const $ = (s) => root.querySelector(s);
      const visits = $('[data-calc-visits]');
      const value = $('[data-calc-value]');
      const uplift = $('[data-calc-uplift]');
      const num = (el) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);

      function update() {
        const u = num(uplift);
        const extra = (num(visits) * u) / 100;
        const month = extra * num(value);
        $('[data-calc-uplift-out]').textContent = '+' + nf2.format(u);
        $('[data-calc-every]').textContent = nf0.format(u ? 100 / u : 0);
        $('[data-calc-extra]').textContent = '+' + (extra < 10 ? nf1 : nf0).format(extra);
        $('[data-calc-month]').textContent = nf0.format(month) + ' €';
        $('[data-calc-year]').textContent = nf0.format(month * 12) + ' €';
        const min = parseFloat(uplift.min), max = parseFloat(uplift.max);
        uplift.style.setProperty('--p', ((u - min) / (max - min)) * 100 + '%');
      }

      [visits, value, uplift].forEach((el) => el.addEventListener('input', update));
      update();
    }

    // Tabs κατά WAI-ARIA: βελάκια, Home/End, ένα tab στη σειρά του Tab.
    // Χρησιμοποιείται από το «Από πού ξεκινάς» και από το «Πριν και μετά».
    function initTabs(root) {
      const tabs = [].slice.call(root.querySelectorAll('[data-tab]'));
      const panels = [].slice.call(root.querySelectorAll('[data-panel]'));
      if (!tabs.length || tabs.length !== panels.length) return;
      root.classList.add('is-enhanced');

      function select(i, focus) {
        tabs.forEach((t, k) => {
          t.setAttribute('aria-selected', String(k === i));
          t.tabIndex = k === i ? 0 : -1;
        });
        panels.forEach((p, k) => { p.hidden = k !== i; });
        if (focus) {
          tabs[i].focus();
          // Στο κινητό η σειρά με τα ονόματα σκρολάρει οριζόντια.
          tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      }

      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          const j = { ArrowRight: (i + 1) % n, ArrowDown: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, ArrowUp: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
          if (j === undefined) return;
          e.preventDefault();
          select(j, true);
        });
      });
      select(0);
    }

    // Με το ClientRouter το astro:page-load πυροδοτείται και στο πρώτο load,
    // οπότε κάθε root σημαδεύεται για να μη δεθούν listeners δύο φορές.
    function once(selector, fn) {
      document.querySelectorAll(selector).forEach((root) => {
        if (root.hasAttribute('data-hv-ready')) return;
        root.setAttribute('data-hv-ready', '');
        fn(root);
      });
    }

    function init() {
      once('[data-calc]', initCalc);
      once('[data-tabs]', initTabs);
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

