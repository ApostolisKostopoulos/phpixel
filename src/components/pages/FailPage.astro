---
import { Icon } from 'astro-icon/components';
import { site } from '@config/site';

/**
 * Στατική σελίδα (Cloudflare Pages). Ο έλεγχος «ήρθες όντως από αποτυχημένη
 * υποβολή;» γίνεται client-side. Σημείωση: παλιά ζητούσε form_status === 'sent',
 * που δεν συνέβαινε ποτέ σε αποτυχία, οπότε η σελίδα έκανε πάντα redirect.
 */
---
  <section class="status-page">
    <div class="container status-page__inner">
      <div class="status-card reveal">
        <div class="status-icon status-icon--error">
          <Icon name="ic:baseline-error" />
        </div>
        <h1>Κάτι πήγε στραβά</h1>
        <!--email_off-->
        <p>Δεν μπορέσαμε να στείλουμε το μήνυμά σου. Δοκίμασε ξανά ή στείλε μας email στο {site.contact.email}.</p>
        <!--/email_off-->
        <div class="status-actions">
          <a href="/contact" class="btn btn--primary">Δοκίμασε ξανά</a>
          <!--email_off-->
          <a href={`mailto:${site.contact.email}`} class="btn btn--outline">Στείλε μας email</a>
          <!--/email_off-->
        </div>
      </div>
    </div>
  </section>

<script is:inline>
  (() => {
    const hit = document.cookie.split('; ').find((c) => c.startsWith('form_status='));
    const status = hit ? decodeURIComponent(hit.slice('form_status='.length)) : null;
    if (status !== 'error') location.replace('/contact');
  })();
</script>

<style>
  .status-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--navbar-height);
  }

  .status-card {
    text-align: center;
    max-width: 520px;
    padding: 3rem;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--theme-shape-radius-lg);
    box-shadow: var(--glass-shadow);
  }

  .status-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
  }

  .status-icon svg,
  .status-icon [data-icon] {
    width: 40px;
    height: 40px;
  }

  .status-icon--error {
    background: color-mix(in srgb, var(--accent-rose) 15%, transparent);
    color: var(--accent-rose);
  }

  .status-card h1 {
    font-size: 1.8rem;
    margin-bottom: 0.75rem;
  }

  .status-card p {
    font-size: 1.05rem;
    opacity: 0.72;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .status-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
