---
import { Icon } from 'astro-icon/components';

/**
 * Η σελίδα είναι στατική (Cloudflare Pages). Το «ήρθες όντως από τη φόρμα;»
 * και το όνομα διαβάζονται client-side από το βραχύβιο cookie που θέτει η
 * function /api/contact — γι' αυτό δεν είναι httpOnly.
 */
---
  <section class="status-page">
    <div class="container status-page__inner">
      <div class="status-card reveal">
        <div class="status-icon status-icon--success">
          <Icon name="ic:baseline-check-circle" />
        </div>
        <h1>Ευχαριστούμε<span data-form-name></span>!</h1>
        <p>Το μήνυμά σου στάλθηκε. Θα σου απαντήσουμε μέσα σε μία εργάσιμη.</p>
        <div class="status-actions">
          <a href="/" class="btn btn--primary">Πίσω στην Αρχική</a>
          <a href="/services" class="btn btn--outline">Οι Υπηρεσίες μας</a>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
  (() => {
    const read = (key) => {
      const hit = document.cookie.split('; ').find((c) => c.startsWith(key + '='));
      return hit ? decodeURIComponent(hit.slice(key.length + 1)) : null;
    };
    // Χωρίς επιτυχημένη υποβολή, η σελίδα δεν έχει νόημα.
    if (read('form_status') !== 'sent') {
      location.replace('/contact');
      return;
    }
    const name = read('form_name');
    const slot = document.querySelector('[data-form-name]');
    if (name && slot) slot.textContent = `, ${name}`;
  })();
</script>

<style>
  .status-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--navbar-height);
  }

  .status-card {
    text-align: center;
    max-width: 520px;
    padding: 3rem;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--theme-shape-radius-lg);
    box-shadow: var(--glass-shadow);
  }

  .status-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
  }

  .status-icon svg,
  .status-icon [data-icon] {
    width: 40px;
    height: 40px;
  }

  .status-icon--success {
    background: color-mix(in srgb, var(--accent-emerald) 15%, transparent);
    color: var(--accent-emerald);
  }

  .status-card h1 {
    font-size: 1.8rem;
    margin-bottom: 0.75rem;
  }

  .status-card p {
    font-size: 1.05rem;
    opacity: 0.72;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .status-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
