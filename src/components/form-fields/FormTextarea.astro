---

const { label, name, placeholder, rows = 4, required} = Astro.props;
---

<div class="form-field__container">
  {label && <label for={name}>{label}</label>}
  <p class="secondary_message">Στείλε μας τα σχόλια και τις ερωτήσεις σου. Θα σου απαντήσουμε το συντομότερο δυνατόν!</p>
  <textarea id={name} name={name} placeholder={placeholder} rows={rows} required={required}></textarea>
</div>

<style>
  .form-field__container textarea{
    --form-field-border-width: 2px;
    width: 100%;
    padding: 0.5rem;
    border: var(--form-field-border-width) solid var(--form-field-border-color, var(--ink-300));
    color: var(--form-field-input-color, var(--theme-on-bg));
    border-radius: var(--form-field-border-radius, 0.25rem);
    outline-style: none;
  }
  .form-field__container textarea:focus {
    border: var(--form-field-border-width) solid var(--form-field-border-focus-color, var(--theme-primary));
  }
</style>
