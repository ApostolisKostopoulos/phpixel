---
import { Button, FormInput, FormSelect, FormTextarea, Form_Input_checkbox } from '@components/odyssey-theme';
---

<form method="POST" action="/api/contact" enctype="application/x-www-form-urlencoded">
  <FormInput type="text" label="Όνομα" name="Name" placeholder="" required />

  <FormInput type="email" label="Email" name="Email" placeholder="" required />

  <FormInput type="tel" label="Τηλέφωνο" name="Phone" placeholder="" required />

  <FormTextarea label="Πες μας λίγα λόγια για το project σου (προαιρετικό)" name="Message" placeholder="" />

  <Form_Input_checkbox label="Συμφωνώ να αποθηκευτούν τα στοιχεία μου ώστε να επικοινωνήσει μαζί μου η phpixel." name="policy" placeholder="" required />

  {/*
    Honeypot: αόρατο για ανθρώπους, ελκυστικό για bots που συμπληρώνουν ό,τι
    input βρουν. Το `/api/contact` το ελέγχει και πετάει σιωπηλά όποια υποβολή
    το έχει γεμάτο. Κρύβεται εκτός οθόνης και όχι με display:none, που τα
    πιο προσεγμένα bots το αναγνωρίζουν.
  */}
  <div class="hp" aria-hidden="true">
    <label for="Website">Άφησε αυτό το πεδίο κενό</label>
    <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
  </div>

  <Button type="submit" big_button>Στείλε το μήνυμα</Button>
</form>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
