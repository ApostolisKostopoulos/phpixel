---
// Props
const { href, unelevated, outlined, customIcon, onPrimary, big_button, newTab, iconPosition = 'after' } = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={[
    'btn',
    { 'btn--unelevated': unelevated },
    { 'btn--outlined': outlined },
    { 'btn--on-primary': onPrimary },
    { 'btn--full': big_button },
  ]}
  href={href}
  target={`${newTab ? '_blank': ``}`}
  rel={`${newTab ? 'noopener noreferrer' : ``}`}
>
  {customIcon && iconPosition === 'before' && (
    <span class="custom-icon__span"><slot name="icon">custom_icon</slot></span>
  )}
  <slot />
  {customIcon && iconPosition === 'after' && (
    <span class="custom-icon__span"><slot name="icon">custom_icon</slot></span>
  )}
</Tag>

<style>

  .btn {
    width: fit-content;
    padding: 0.36rem 0.70rem;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Ήταν --button_color και --theme-button-border-radius: κανένα από τα δύο
       δεν ορίζεται στο theme.css, οπότε το κουμπί έβγαινε χωρίς φόντο —
       λευκά γράμματα σε λευκό, δηλαδή αόρατο submit στη φόρμα επικοινωνίας. */
    background-color: var(--button-color);
    color: var(--button-text);
    border: none;
    border-radius: var(--button-border-radius);
    font-weight: 500;
    gap: 10px;
  }
  .btn--full {
    width: 100%;
  }
  .btn:hover {
    background-color: var(--button-color-hover);
  }
  .btn--unelevated {
    background-color: transparent;
    color: var(--theme-on-bg);
  }
  .btn--unelevated:hover {
    background-color: transparent;
    color: var(--theme-primary);
  }
  .btn--outlined {
    color: var(--theme-primary);
    background-color: transparent;
    border: 2px solid var(--theme-primary);
    transition: background-color var(--theme-transition);
  }
  .btn--outlined:hover {
    background-color: var(--theme-primary);
    color: var(--theme-on-primary);
  }
  .custom-icon__span {
    margin: 0 0.25rem; /* left or right depending on position */
    display: flex;
    align-items: center;
  }
  .custom-icon__span :global(svg) {
    width: 24px;
    height: 24px;
  }
  a.btn {
    text-decoration: none;
  }
  button.btn {
    cursor: pointer;
    outline: none;
  }
</style>
