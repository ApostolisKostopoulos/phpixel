---
/**
 * Footer. Κανόνας ιδιοκτήτη: email ναι, τηλέφωνο όχι (μόνο στο /contact),
 * και καμία γραμμή διεύθυνσης.
 * Styles: src/styles/layout.css.
 */
import { Icon } from 'astro-icon/components';
import Logo from '../Logo.astro';
import { site, footerLists, footerSocials } from '../../config/site';
---

<footer class="footer" id="footer">
	<div class="footer__inner">
		<div class="footer__brand">
			{/* Το κάθετο λογότυπο έχει ήδη μέσα του το tagline, γι' αυτό δεν
			    επαναλαμβάνεται από κάτω σε <p>. */}
			<Logo
				variant="vertical"
				tone="light"
				alt={`${site.name}. ${site.tagline}`}
				loading="lazy"
				class="footer__logo"
			/>
			<p class="footer__contact">
				<!--email_off--><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><!--/email_off-->
			</p>
			<div class="footer__socials">
				{footerSocials.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={social.name}
						class="social-link"
					>
						<Icon name={social.icon} />
					</a>
				))}
			</div>
		</div>

		{footerLists.map((list) => (
			<div class="footer__list">
				<p class="footer__list-title">{list.title}</p>
				<ul>
					{list.items.map((item) => (
						<li><a href={item.slug}>{item.title}</a></li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div class="footer__bottom">
		<p>
			&copy; {new Date().getFullYear()} {site.name}. All rights reserved.
			<span class="footer__bottom-sep">|</span>
			<button type="button" class="footer__cookie-settings" data-cookie-settings>
				Ρυθμίσεις cookies
			</button>
		</p>
	</div>
</footer>
