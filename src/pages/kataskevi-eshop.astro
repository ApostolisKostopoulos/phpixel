---
import Layout from '@layouts/Page.astro';
import EshopPage from '@components/pages/EshopPage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.eshop,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'Κατασκευή E-shop' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'Κατασκευή E-shop',
      description: 'Κατασκευή e-shop για B2C & B2B: WooCommerce, custom ή CS-Cart, με σύνδεση σε ERP, courier και Skroutz.',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <EshopPage />
</Layout>
