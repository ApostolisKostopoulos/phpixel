---
import Layout from "@layouts/Page.astro";
import PortfolioPage from "@components/pages/PortfolioPage.astro";
import { seo } from "@config/site";
import { getProjects } from "@utils/content";

const projects = await getProjects();

const collectionSchema = {
  "@type": "CollectionPage",
  name: "phpixel Portfolio",
  url: new URL("/portfolio", Astro.site).href,
  description: "Έργα ιστοσελίδων, e-shop και web εφαρμογών της phpixel.",
  hasPart: projects.map((p) => ({
    "@type": "CreativeWork",
    name: p.data.name,
    url: new URL(`/portfolio/${p.id}`, Astro.site).href,
    image: new URL(p.data.thumb, Astro.site).href,
    description: p.data.tagline,
  })),
};
---

<Layout seo={{ ...seo.portfolio, schema: [collectionSchema] }}>
  <PortfolioPage />
</Layout>
