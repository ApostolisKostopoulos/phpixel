---
import Layout from '@layouts/Page.astro';
import AdsPage from '@components/pages/AdsPage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.ads,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'Google Ads & Social' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'Google Ads & Social Media Διαφήμιση',
      description: 'Διαχείριση Google Ads (Search & Shopping), Meta ads και οργανικού περιεχομένου με μετρήσιμο αποτέλεσμα.',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <AdsPage />
</Layout>
