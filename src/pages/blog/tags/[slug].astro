---
import type { GetStaticPaths } from 'astro';
import Layout from '@layouts/Page.astro';
import TagPage from '@components/pages/TagPage.astro';
import { getPosts, type PostEntry } from '@utils/content';
import { generateSlug } from '@utils/helpers';

/**
 * Μία σελίδα ανά tag που εμφανίζεται σε τουλάχιστον ένα δημοσιευμένο άρθρο.
 * Παλιά η σελίδα έκανε redirect όταν το tag δεν υπήρχε — τώρα απλώς δεν
 * παράγεται, οπότε ένα άγνωστο tag δίνει κανονικό 404.
 */
export const getStaticPaths = (async () => {
	const posts = await getPosts();
	const byTag = new Map<string, { tag: string; posts: PostEntry[] }>();

	for (const post of posts) {
		for (const tag of post.data.tags) {
			const slug = generateSlug(tag);
			if (!byTag.has(slug)) byTag.set(slug, { tag, posts: [] });
			byTag.get(slug)!.posts.push(post);
		}
	}

	return Array.from(byTag.entries()).map(([slug, { tag, posts }]) => ({
		params: { slug },
		props: { tag, posts },
	}));
}) satisfies GetStaticPaths;

interface Props {
	tag: string;
	posts: PostEntry[];
}

const { tag, posts } = Astro.props as Props;

const pageSeo = {
	title: `Άρθρα: ${tag} | Blog phpixel`,
	description: `Όλα τα άρθρα της phpixel με θέμα ${tag}.`,
	breadcrumbs: [{ name: 'Blog', path: '/blog' }, { name: tag }],
};
---

<Layout seo={pageSeo}>
	<TagPage tag={tag} posts={posts} />
</Layout>
