---
import type { GetStaticPaths } from 'astro';
import Layout from '@layouts/Page.astro';
import CaseStudyPage from '@components/pages/CaseStudyPage.astro';
import { getProjects, type ProjectEntry } from '@utils/content';
import { caseStudySchema } from '@utils/schema';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
	entry: ProjectEntry;
}

const { entry } = Astro.props as Props;
const p = entry.data;

const pageSeo = {
	title: p.caseStudy.metaTitle,
	description: p.caseStudy.metaDescription,
	image: p.hero,
	breadcrumbs: [{ name: 'Portfolio', path: '/portfolio' }, { name: p.name }],
	schema: [
		{
			...caseStudySchema(Astro.site, {
				name: p.name,
				description: p.caseStudy.metaDescription,
				path: `/portfolio/${entry.id}`,
				image: p.hero,
				year: p.year,
			}),
			headline: p.caseStudy.heroTitle,
			about: p.industry,
			keywords: p.tags.join(', '),
		},
	],
};
---

<Layout seo={pageSeo}>
	<CaseStudyPage entry={entry} />
</Layout>
