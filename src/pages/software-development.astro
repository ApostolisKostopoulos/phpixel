---
import Layout from '@layouts/Page.astro';
import SoftwarePage from '@components/pages/SoftwarePage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.software,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'Custom Εφαρμογές' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'Custom Web Εφαρμογές & Αυτοματισμοί',
      description: 'Custom εφαρμογές, dashboards και αυτοματισμοί: συνδέσεις με ERP και συστήματα, λιγότερη χειροκίνητη δουλειά.',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <SoftwarePage />
</Layout>
