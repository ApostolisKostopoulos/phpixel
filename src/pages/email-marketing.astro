---
import Layout from '@layouts/Page.astro';
import EmailMarketingPage from '@components/pages/EmailMarketingPage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.emailMarketing,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'Email Marketing' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'Email Marketing',
      description: 'Αυτοματισμοί email για e-shop: εγκαταλελειμμένα καλάθια, welcome series, newsletters και win-back flows.',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <EmailMarketingPage />
</Layout>
