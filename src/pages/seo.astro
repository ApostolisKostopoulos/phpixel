---
import Layout from '@layouts/Page.astro';
import SeoPage from '@components/pages/SeoPage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.seo,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'SEO & AEO' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'SEO & AEO',
      description: 'SEO για e-shop και εταιρικά sites: on-page, technical και περιεχόμενο, μαζί με βελτιστοποίηση για AI αναζήτηση (AEO/GEO).',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <SeoPage />
</Layout>
