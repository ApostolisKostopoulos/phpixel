---
import Layout from '@layouts/Page.astro';
import WebsitesPage from '@components/pages/WebsitesPage.astro';
import { seo } from '@config/site';
import { serviceSchema } from '@utils/schema';

const pageSeo = {
  ...seo.websites,
  breadcrumbs: [{ name: 'Υπηρεσίες', path: '/services' }, { name: 'Ιστοσελίδες & Landing Pages' }],
  schema: [
    serviceSchema(Astro.site, {
      serviceType: 'Κατασκευή Ιστοσελίδων & Landing Pages',
      description: 'Γρήγορες, καθαρές ιστοσελίδες και landing pages με custom σχεδιασμό και SEO από την πρώτη γραμμή κώδικα.',
    }),
  ],
};
---

<Layout seo={pageSeo}>
  <WebsitesPage />
</Layout>
