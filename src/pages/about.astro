---
import Layout from '@layouts/Page.astro';
import AboutPage from '@components/pages/AboutPage.astro';
import { seo, site } from '@config/site';

/**
 * Η σελίδα «Σχετικά» είναι το σημείο όπου η μηχανή αναζήτησης δένει το brand με
 * το πρόσωπο πίσω του, γι' αυτό δηλώνει ρητά τον ιδρυτή στο AboutPage node.
 */
const pageSeo = {
	...seo.about,
	schema: [
		{
			'@type': 'AboutPage',
			name: 'Σχετικά με την phpixel',
			url: new URL('/about', Astro.site).href,
			inLanguage: site.lang,
			mainEntity: { '@id': `${new URL('/', Astro.site).href}#organization` },
		},
		{
			'@type': 'Person',
			name: site.blogAuthor.name,
			description: site.blogAuthor.oneLiner,
			worksFor: { '@id': `${new URL('/', Astro.site).href}#organization` },
			knowsAbout: [
				'E-commerce',
				'WooCommerce',
				'Κατασκευή ιστοσελίδων',
				'SEO',
				'Email marketing',
			],
		},
	],
};
---

<Layout seo={pageSeo}>
	<AboutPage />
</Layout>
