---
/**
 * Η κανονική σελίδα: Base + navbar + footer. Ό,τι χρησιμοποιούν όλες οι
 * διαδρομές στο src/pages/.
 */
import Base from './Base.astro';
import Header from '../components/core/Header.astro';
import Footer from '../components/core/Footer.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';

export interface Props {
	seo?: BaseHeadProps;
	/** Διάφανο navbar πάνω από σκούρο hero, μέχρι το πρώτο scroll. */
	darkHero?: boolean;
}

const { seo, darkHero = false } = Astro.props;
---

<Base seo={seo}>
	<Header slot="header" darkHero={darkHero} />
	<slot />
	<Footer slot="footer" />
</Base>
